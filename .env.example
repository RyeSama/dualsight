# DualSight environment template.
# Copy to .env and fill in the providers you actually use.
# Process environment variables take precedence over this file.

# ── HTTP server ──────────────────────────────────────────────────────────────
DUALSIGHT_HOST=127.0.0.1
DUALSIGHT_PORT=8000
# Require Authorization: Bearer <key> on API requests. Leave empty for local-only use.
# DUALSIGHT_SERVER_API_KEY=change-me
DUALSIGHT_CORS_ORIGINS=*
DUALSIGHT_MAX_BODY_BYTES=26214400
DUALSIGHT_REQUEST_TIMEOUT_S=180
DUALSIGHT_LOG_LEVEL=INFO
DUALSIGHT_LOG_JSON=false
DUALSIGHT_DEMO_ENABLED=true

# ── Vision / perception provider ─────────────────────────────────────────────
# openai | anthropic | gemini | mock
DUALSIGHT_VISION_PROVIDER=openai
DUALSIGHT_VISION_API_KEY=
# DUALSIGHT_VISION_BASE_URL=https://api.openai.com/v1
# DUALSIGHT_VISION_MODEL=gpt-4o-mini
DUALSIGHT_VISION_TIMEOUT_S=60
DUALSIGHT_VISION_MAX_RETRIES=2
DUALSIGHT_VISION_MAX_TOKENS=1600
DUALSIGHT_VISION_TEMPERATURE=0
# Extra headers / body fields, JSON objects. Useful for gateways and custom params.
# DUALSIGHT_VISION_HEADERS={"X-Project":"dualsight"}
# DUALSIGHT_VISION_EXTRA_BODY={"service_tier":"auto"}

# ── Text / reasoning provider ────────────────────────────────────────────────
# Defaults to the vision provider when omitted.
# DUALSIGHT_TEXT_PROVIDER=openai
DUALSIGHT_TEXT_API_KEY=
# DUALSIGHT_TEXT_BASE_URL=https://api.openai.com/v1
# DUALSIGHT_TEXT_MODEL=gpt-4o-mini
DUALSIGHT_TEXT_TIMEOUT_S=120
DUALSIGHT_TEXT_MAX_RETRIES=2
DUALSIGHT_TEXT_MAX_TOKENS=2048
DUALSIGHT_TEXT_TEMPERATURE=0.3
# DUALSIGHT_TEXT_HEADERS={}
# DUALSIGHT_TEXT_EXTRA_BODY={"service_tier":"auto"}

# Provider-native fallbacks, used when the DUALSIGHT_* key is empty:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Image intake ─────────────────────────────────────────────────────────────
DUALSIGHT_IMAGE_MAX_BYTES=12582912
DUALSIGHT_IMAGE_MAX_PIXELS=40000000
DUALSIGHT_IMAGE_MAX_DIM=1568
DUALSIGHT_IMAGE_JPEG_QUALITY=85
DUALSIGHT_IMAGE_FETCH_TIMEOUT_S=20
DUALSIGHT_MAX_IMAGES=8
# Only enable on a trusted network: allows loopback/private image URLs.
DUALSIGHT_ALLOW_PRIVATE_IMAGE_URLS=false

# ── Bridge behaviour ─────────────────────────────────────────────────────────
# auto | photo | document | ui | chart | receipt | diagram
DUALSIGHT_PROFILE=auto
# brief | standard | deep
DUALSIGHT_DETAIL=standard
DUALSIGHT_MAX_EVIDENCE_CHARS=12000
DUALSIGHT_PERCEPTION_CONCURRENCY=4
# degrade: inject an honest "unavailable" evidence block; fail: return an error.
DUALSIGHT_ON_VISION_ERROR=degrade
# system | user
DUALSIGHT_INJECT_MODE=system
DUALSIGHT_TRACE_IN_RESPONSE=true
DUALSIGHT_ALLOW_MODEL_OVERRIDE=false

# ── Perception cache ─────────────────────────────────────────────────────────
# none | memory | sqlite
DUALSIGHT_CACHE=memory
DUALSIGHT_CACHE_TTL_S=86400
DUALSIGHT_CACHE_MAX_ENTRIES=512
DUALSIGHT_CACHE_PATH=.dualsight/cache.sqlite3

# ── Convenience ──────────────────────────────────────────────────────────────
DUALSIGHT_MOCK=false
DUALSIGHT_PRETTY_JSON=false
